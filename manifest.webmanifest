{
  "name": "Ticketmaster — Live Events",
  "short_name": "Ticketmaster",
  "description": "A mobile-first Ticketmaster front-end clone with event discovery, watchlist, tickets and account screens.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0b0b0b",
  "theme_color": "#0b0b0b",
  "lang": "en-US",
  "categories": ["entertainment", "tickets", "music", "sports"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "assets/screens/home.jpg",
      "sizes": "1080x2220",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Discover events with Ticketmaster"
    },
    {
      "src": "assets/screens/watchlist.jpg",
      "sizes": "1080x2220",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Keep track of your watchlist"
    }
  ],
  "shortcuts": [
    {
      "name": "My Tickets",
      "short_name": "Tickets",
      "url": "./#/tickets",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Watchlist",
      "short_name": "Watchlist",
      "url": "./#/watchlist",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
